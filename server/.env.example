# SQLite (default, free, zero-config). File path is relative to server/prisma.
DATABASE_URL="file:./dev.db"

# For a free hosted Postgres instead (Neon, Supabase, etc.), switch the
# provider in prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

PORT=4000

# Cron schedule (node-cron syntax) for automatic scraping. Default: every 6 hours.
SCRAPE_CRON="0 */6 * * *"

# Shared secret required to call POST /api/scrape/run from an external
# scheduler (e.g. the GitHub Actions workflow). Leave blank to disable auth
# on that endpoint (fine for local dev only).
SCRAPE_TRIGGER_TOKEN=

# Comma-separated list of origins allowed to call the API (your deployed
# frontend URL). Use "*" for local dev.
CORS_ORIGIN="*"
