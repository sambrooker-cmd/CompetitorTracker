# Postgres connection string. For local dev, either a local Postgres:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/competitor_tracker"
# ...or a free Neon/Supabase project (a separate branch/project from
# production works well for local dev — see README "Local development"):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=4000

# Set to "false" to pause ALL scraping — the scheduled cron jobs (both
# SCRAPE_CRON and DISCOVERY_CRON below) and the manual trigger endpoints
# (/api/scrape/run, /api/scrape/offers/:id, /api/discovery/run,
# /api/ambassador-routes/ingest) all become no-ops (503) — without taking
# the API/dashboard offline, so existing data stays viewable. Useful while
# reviewing robots.txt/ToS coverage across the competitor set. Defaults to
# enabled when unset.
SCRAPING_ENABLED=

# Cron schedule (node-cron syntax) for automatic scraping. Default: daily at
# 06:00 UTC — cruise pricing/offers don't move hourly.
SCRAPE_CRON="0 6 * * *"

# Cron schedule for the (much lower-frequency) listing-discovery scrape —
# see "Discovering new cruises automatically" in README. Default: weekly,
# Monday 05:00 UTC. Only runs for competitors with a listingUrl configured;
# matches are queued for human review, never auto-approved.
DISCOVERY_CRON="0 5 * * 1"

# Shared secret required to call POST /api/scrape/run from an external
# scheduler (e.g. the GitHub Actions workflow). Leave blank to disable auth
# on that endpoint (fine for local dev only).
SCRAPE_TRIGGER_TOKEN=

# Comma-separated list of origins allowed to call the API (your deployed
# frontend URL). Use "*" for local dev.
CORS_ORIGIN="*"
