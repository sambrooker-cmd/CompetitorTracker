// Prisma schema for the Competitor Pricing & Promotions Tracker.
//
// Uses Postgres (a free Neon or Supabase project works fine) for both
// local dev and deployment — not SQLite, since most free hosting tiers
// (e.g. Render's free web service) have an ephemeral filesystem that
// wipes a SQLite file on every restart/redeploy. Using the same provider
// everywhere also avoids maintaining two sets of migrations. See
// README.md "Local development" for how to point DATABASE_URL at either
// a local Postgres or a free Neon/Supabase branch.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Note: fields documented as "one of ..." below are plain Strings rather
// than Prisma `enum`s — validated in the API layer (see lib/constants.ts)
// instead of at the DB level, so adding a new value (e.g. another
// competitor tier) is a constant change, not a migration.

model Competitor {
  id           Int       @id @default(autoincrement())
  name         String
  website      String
  // One of: "direct" (closest product/size peers), "international" (bigger
  // premium/mainstream lines), "trade" (OTA/independent agents reselling
  // other lines' product).
  tier         String
  parentGroup  String?
  notes        String?
  // Where to scrape this competitor's current headline offers/promotions
  // (distinct from per-sailing pricing pages tracked via Product below).
  offersUrl       String?
  offerSelector   String? // CSS selector matching each individual offer/promo element
  renderMode      String  @default("static") // "static" (axios+cheerio) or "js" (headless browser)

  // Discovery: a search/listing page (e.g. Fred. Olsen's /cruise-deals) that
  // can be scraped periodically to find current cruises, rather than each
  // one being registered by hand. Selectors are relative to each matched
  // card. listingFlyIndicatorSelector's presence/absence marks a card as a
  // fly-cruise vs ex-UK no-fly — the actual ex_uk/fly_caribbean route type
  // is then decided by scraper/discoverListing.ts against a Caribbean
  // destination keyword list, since "fly" alone isn't "fly-Caribbean".
  listingUrl                   String?
  listingCardSelector          String?
  listingNameSelector          String?
  listingUrlSelector           String?
  listingNightsSelector        String?
  listingFlyIndicatorSelector  String?
  // Alternative to the selectors above, for listing pages that expose
  // structured data attributes directly on the card element (e.g. Fred.
  // Olsen's /cruises: data-cruise-name, data-duration, data-cruise-type) —
  // more robust than text-scraping nested elements when available. Takes
  // precedence over the matching *Selector field when both are set.
  listingNameAttr                 String?
  listingNightsAttr               String?
  listingFlyIndicatorAttr         String?
  // The attribute value (from listingFlyIndicatorAttr) that means "NOT a
  // fly-cruise" (e.g. Fred. Olsen's "CruiseOnly") — any other value present
  // on that attribute is treated as a fly-cruise.
  listingFlyIndicatorNonFlyValue  String?

  products               Product[]
  offers                 Offer[]
  discoveredSailings     DiscoveredSailing[]
  cabinSelectorTemplates CabinSelectorTemplate[]
  createdAt              DateTime  @default(now())
}

// A reusable price selector for one cabin type on this competitor's cruise
// detail pages, e.g. Fred. Olsen's "#interior-standard-tab .price" — proven
// (across multiple cruises during manual setup) to work for ANY cruise on
// that site, not just the one it was first found on. This is what lets a
// newly discovered cruise (see DiscoveredSailing) be turned into full
// per-cabin tracked sailings from just a URL, without needing fresh HTML.
model CabinSelectorTemplate {
  id            Int        @id @default(autoincrement())
  competitorId  Int
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  cabinType     String
  priceSelector String
  promoSelector String?
  renderMode    String     @default("static")
  notes         String?
  createdAt     DateTime   @default(now())

  @@unique([competitorId, cabinType])
}

// Ambassador's own sailing programme — the canonical reference that
// discovered competitor cruises are matched against for "parity" tracking.
// Populated from ambassadorcruiseline.com itself (see README), not
// invented — this table starts empty until that source is scraped/entered.
model AmbassadorRoute {
  id                 Int                 @id @default(autoincrement())
  destination        String
  routeType          String // "ex_uk" or "fly_caribbean"
  nightsMin          Int
  nightsMax          Int
  departurePort      String?
  sourceUrl          String?
  active             Boolean             @default(true)
  firstSeenAt        DateTime            @default(now())
  lastSeenAt         DateTime            @default(now())
  discoveredSailings DiscoveredSailing[]

  @@index([routeType, destination])
}

// A candidate cruise found by a competitor's listing-discovery scraper,
// awaiting human approval before it becomes a real tracked sailing (Phase
// 2 of the discovery rollout — see README). Only candidates that classify
// as ex_uk or fly_caribbean AND match an AmbassadorRoute are queued here;
// anything else (e.g. a fly-cruise to a non-Caribbean destination) is
// out of scope and never stored.
model DiscoveredSailing {
  id             Int              @id @default(autoincrement())
  competitorId   Int
  competitor     Competitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  matchedRouteId Int?
  matchedRoute   AmbassadorRoute? @relation(fields: [matchedRouteId], references: [id])
  name           String
  url            String
  destination    String?
  nights         Int?
  routeType      String?
  priceHint      String?
  status         String           @default("pending") // pending | approved | rejected
  discoveredAt   DateTime         @default(now())
  reviewedAt     DateTime?

  @@index([competitorId, status])
}

// A representative tracked sailing/itinerary used as a pricing sample point
// for a competitor (not every cabin on every sailing — see README).
model Product {
  id            Int          @id @default(autoincrement())
  name          String
  url           String
  priceSelector String
  promoSelector String?
  currency      String       @default("GBP")
  // One of: "ex_uk" (no-fly, departs a UK port) or "fly_caribbean".
  routeType     String?
  destination   String?
  nights        Int?
  // One of: "inside", "oceanview", "balcony", "suite" (or a competitor's own label).
  cabinType     String?
  renderMode    String       @default("static") // "static" or "js"
  competitorId  Int
  competitor    Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  priceEntries  PriceEntry[]
  createdAt     DateTime     @default(now())

  @@index([competitorId])
}

model PriceEntry {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float?
  promoText  String?
  rawPrice   String?
  error      String?
  scrapedAt  DateTime @default(now())

  @@index([productId, scrapedAt])
}

// A headline offer/promotion advertised by a competitor (e.g. "Free drinks
// package", "Kids sail free"), tracked separately from per-sailing pricing
// since offers are brand/site-wide rather than tied to one itinerary.
model Offer {
  id              Int       @id @default(autoincrement())
  competitorId    Int
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  title           String
  detail          String?
  rawText         String?
  validFrom       DateTime?
  validUntil      DateTime?
  whileStocksLast Boolean   @default(false)
  active          Boolean   @default(true)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  endedAt         DateTime?

  @@index([competitorId, active])
}
