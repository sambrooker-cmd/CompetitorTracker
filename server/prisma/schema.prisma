// Prisma schema for the Competitor Pricing & Promotions Tracker.
//
// Defaults to SQLite (zero-config, free, file-based) for local dev and
// small free-tier deployments. To use a free hosted Postgres instead
// (e.g. Neon or Supabase free tier), change the provider below to
// "postgresql" and set DATABASE_URL accordingly — no other code changes
// are needed since the app only uses Prisma's generated client.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Note: fields documented as "one of ..." below are plain Strings rather
// than Prisma `enum`s, since Prisma emulates enums on SQLite with no DB-level
// constraint anyway — a String keeps the default SQLite setup and a swap to
// Postgres both simple, with validation done in the API layer.

model Competitor {
  id           Int       @id @default(autoincrement())
  name         String
  website      String
  // One of: "direct" (closest product/size peers), "international" (bigger
  // premium/mainstream lines), "trade" (OTA/independent agents reselling
  // other lines' product).
  tier         String
  parentGroup  String?
  notes        String?
  // Where to scrape this competitor's current headline offers/promotions
  // (distinct from per-sailing pricing pages tracked via Product below).
  offersUrl       String?
  offerSelector   String? // CSS selector matching each individual offer/promo element
  renderMode      String  @default("static") // "static" (axios+cheerio) or "js" (headless browser)
  products     Product[]
  offers       Offer[]
  createdAt    DateTime  @default(now())
}

// A representative tracked sailing/itinerary used as a pricing sample point
// for a competitor (not every cabin on every sailing — see README).
model Product {
  id            Int          @id @default(autoincrement())
  name          String
  url           String
  priceSelector String
  promoSelector String?
  currency      String       @default("GBP")
  // One of: "ex_uk" (no-fly, departs a UK port) or "fly_caribbean".
  routeType     String?
  destination   String?
  nights        Int?
  // One of: "inside", "oceanview", "balcony", "suite" (or a competitor's own label).
  cabinType     String?
  renderMode    String       @default("static") // "static" or "js"
  competitorId  Int
  competitor    Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  priceEntries  PriceEntry[]
  createdAt     DateTime     @default(now())

  @@index([competitorId])
}

model PriceEntry {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float?
  promoText  String?
  rawPrice   String?
  error      String?
  scrapedAt  DateTime @default(now())

  @@index([productId, scrapedAt])
}

// A headline offer/promotion advertised by a competitor (e.g. "Free drinks
// package", "Kids sail free"), tracked separately from per-sailing pricing
// since offers are brand/site-wide rather than tied to one itinerary.
model Offer {
  id              Int       @id @default(autoincrement())
  competitorId    Int
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  title           String
  detail          String?
  rawText         String?
  validFrom       DateTime?
  validUntil      DateTime?
  whileStocksLast Boolean   @default(false)
  active          Boolean   @default(true)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  endedAt         DateTime?

  @@index([competitorId, active])
}
